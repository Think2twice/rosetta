ROSETTA_API_KEY=<YOUR_LOCAL_GATEWAY_KEY>
ROSETTA_DEFAULT_MODEL=gpt-5-5
ROSETTA_PUBLIC_BASE_URL=http://127.0.0.1:13283
ROSETTA_IMAGE_DIR=/data/generated-images
ROSETTA_UPLOAD_DIR=/data/uploads/openai
ROSETTA_MAX_INPUT_ATTACHMENT_BYTES=20971520
ROSETTA_ALLOW_LOCAL_FILE_PATHS=false
ROSETTA_CDP_HOST=127.0.0.1
ROSETTA_CDP_PORT=9222
